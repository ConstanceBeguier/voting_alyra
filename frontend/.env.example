NEXT_PUBLIC_PROJECT_ID=

# Origin the app is served from; must match what the wallet sees
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployed Voting contract, per chain
NEXT_PUBLIC_VOTING_ADDRESS_LOCAL=
NEXT_PUBLIC_VOTING_ADDRESS_SEPOLIA=

# Chain selected by default, before a wallet is connected.
# 31337 = local Hardhat node, 11155111 = Sepolia
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111
